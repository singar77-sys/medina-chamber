# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scraper debug + report output (regenerated on demand, shouldn't
# live in git history — they're scraper byproducts, not source)
scripts/_debug-raw.html
scripts/image-catalog.json
scripts/link-audit-report.json
scripts/logo-scrape-report.json
scripts/*.log

# Designer scratch — HTML mockups, .jsx design files, pasted-screenshot
# uploads, and the unused asset tree under "public/images/chamber events/"
# (note: space in the path — the canonical in-app asset paths live under
# public/images/chamber-logos/, public/images/events/, etc). ~32 MB of
# reference material that nothing in src/ imports; keeping it local only.
public/images/chamber events/

# Video files — source .mov and transcoded .mp4 are too large for git;
# they live in Vercel Blob / YouTube. Poster .webp frames are committed.
*.mov
*.mp4

# Local tool/agent configs
.agents/
.aidesigner/
.mcp.json
.omc/

# Audit / staging output — files downloaded for review and reports
# generated by scripts/audit-community-investor-logos.mjs. Never
# shipped; never sourced from. Regenerate any time.
/tmp/

# Event photo archives — 12 GB+ of WebP galleries, served via Vercel Blob
# in production. Too large for git. Use scripts/sync-sharepoint-photos.mjs
# to upload to Blob storage instead.
public/images/events/

# Historical ribbon-cutting / event photos (public/images/archive/) — ~37 MB
# of high-res JPEGs that nothing in src/ renders (not referenced literally,
# not scanned by getStaticPhotos). Removed from git tracking in the asset
# diet; a local copy is kept under .archive-backup/ (also ignored below) in
# case the chamber wants the originals back. Keep out of git going forward.
public/images/archive/

# Local backup of the removed historical archive photos — never shipped.
.archive-backup/
