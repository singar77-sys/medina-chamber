# ══════════════════════════════════════════════════════════════════════════════
# medina-chamber-site — environment reference (placeholders only, never secrets)
# Copy to .env.local for development. Production values live in Vercel env vars.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase Postgres via the transaction-mode pooler. The app forces TLS
# (ssl: "require") regardless of the sslmode in this URL.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# ── Admin auth ────────────────────────────────────────────────────────────────
# Two login modes, decided by whether ADMIN_USERS is set:
#
#   ADMIN_USERS unset  → shared mode: CHAT_ADMIN_TOKEN (>=16 chars) is the sole
#                        login credential, recorded as "Admin".
#   ADMIN_USERS set    → named mode: comma-separated Name:token pairs; each
#                        token must be >=32 chars (openssl rand -hex 32).
#                        CHAT_ADMIN_TOKEN is then IGNORED and can be removed.
#                        Revoke one person by deleting their entry.
#
# FAIL-CLOSED: if ADMIN_USERS is set but any entry is malformed or any token is
# under 32 chars, admin auth is disabled entirely (503 at login, live sessions
# rejected) until the value is fixed or unset. A typo never silently re-enables
# the shared token.
#ADMIN_USERS=Stephanie:REPLACE_64_HEX_FROM_openssl_rand,Jaclyn:REPLACE_64_HEX
CHAT_ADMIN_TOKEN=REPLACE_min_16_chars_random

# Signs/verifies the admin session cookie ONLY — separate from the login
# credential, so rotating one never invalidates the other. REQUIRED in
# production, >=32 chars (openssl rand -hex 32); throws at first use if
# missing/short. Dev falls back to CHAT_ADMIN_TOKEN.
ADMIN_SESSION_SECRET=REPLACE_min_32_chars_random

# ── Member portal auth ────────────────────────────────────────────────────────
# Signs portal magic-link tokens + portal session cookies. >=32 chars required.
PORTAL_AUTH_SECRET=REPLACE_min_32_chars_random

# ── Cron + monitoring auth ────────────────────────────────────────────────────
# Bearer credential for /api/cron/gz-sync (scheduled), /api/cron/renewal and
# /api/cron/join-sweep (dormant until cutover), and the detailed variant of
# /api/health. >=16 chars enforced; use 64 hex (openssl rand -hex 32).
CRON_SECRET=REPLACE_64_hex_random

# ── Canonical site URL — REQUIRED in production ───────────────────────────────
# Builds Stripe checkout success/cancel URLs and portal magic-link URLs. The
# app fails closed in production if unset (a spoofable request Host must never
# determine a redirect/login-link origin). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://medinaohchamber.com

# ── Upstash (rate limiting, chat logs, CMS store, search vectors) ─────────────
UPSTASH_REDIS_REST_URL=https://REPLACE.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE
UPSTASH_VECTOR_REST_URL=https://REPLACE.upstash.io
UPSTASH_VECTOR_REST_TOKEN=REPLACE

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sending domain is medinaohchamber.com (Resend-verified).
RESEND_API_KEY=re_REPLACE
#RESEND_WEBHOOK_SECRET=whsec_REPLACE   # set when the Resend webhook is registered

# ── AI (ChamberBot) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE
# Optional abuse-control overrides (sane defaults in code):
#CHAT_PER_IP_WARN_TOKENS=100000
#CHAT_PER_IP_BLOCK_TOKENS=200000
#CHAT_LOG_TTL_DAYS=90

# ── Stripe (dormant until GrowthZone cutover) ─────────────────────────────────
#STRIPE_SECRET_KEY=sk_test_REPLACE
#STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# ── Kill switches — KEEP UNSET IN PRODUCTION until the GrowthZone cutover ─────
# Enabling these turns on internal join/checkout flows and renewal billing.
#INTERNAL_TRANSACTIONS_ENABLED=true
#RENEWALS_ENABLED=true

# ── Media / misc ──────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE
#GOOGLE_PLACES_API_KEY=REPLACE          # member ratings scrape

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=https://REPLACE.ingest.sentry.io/REPLACE
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE.ingest.sentry.io/REPLACE
#SENTRY_AUTH_TOKEN=sntrys_REPLACE       # source-map upload at build time
